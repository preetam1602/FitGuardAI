DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODEL=openai/gpt-oss-20b
CRITIC_MODEL=openai/gpt-oss-20b
SELF_RAG_CRITIC=true
RAG_RERANK=true
# Required, at least 32 characters. start.ps1 fills this in when it creates .env; otherwise generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
# Refresh cookie is Secure (HTTPS-only); browsers still accept it on http://localhost.
# Set to false only if you serve the app over plain HTTP on another host.
COOKIE_SECURE=true
PORT=3001
DEBUG=false
FRONTEND_URL=http://localhost:5173

# Brute-force limits for login/register (defaults shown)
# LOGIN_WINDOW_S=900
# LOGIN_MAX_ATTEMPTS_PER_EMAIL=5
# LOGIN_MAX_ATTEMPTS_PER_IP=20
# REGISTER_WINDOW_S=3600
# REGISTER_MAX_PER_IP=5

# Diet blueprints cost several LLM calls each (defaults shown)
# DIET_WINDOW_S=3600
# DIET_MAX_PER_USER=10
# DIET_MAX_PER_IP_ANONYMOUS=3
